PlayerTab:AddToggle("Fly", {
    Title = "Fly",
    Default = false,
    Callback = function(Value)
        if Value then
            local character = LocalPlayer.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then return end

            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Velocity = Vector3.zero
            bv.Parent = character.HumanoidRootPart

            bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.P = 1000
            bg.D = 50
            bg.Parent = character.HumanoidRootPart

            character.Humanoid.PlatformStand = true

            flyConnection = RunService.RenderStepped:Connect(function()
                if not Fluent.Options["Fly"].Value then return end
                bg.CFrame = workspace.CurrentCamera.CoordinateFrame
                local controlModule = require(LocalPlayer.PlayerScripts:WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
                local direction = controlModule:GetMoveVector()
                bv.Velocity = Vector3.zero
                if direction.X ~= 0 then
                    bv.Velocity += workspace.CurrentCamera.CFrame.RightVector * (direction.X * Fluent.Options["FlySpeed"].Value)
                end
                if direction.Z ~= 0 then
                    bv.Velocity -= workspace.CurrentCamera.CFrame.LookVector * (direction.Z * Fluent.Options["FlySpeed"].Value)
                end
            end)
        else
            if flyConnection then flyConnection:Disconnect() flyConnection = nil end
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                LocalPlayer.Character.Humanoid.PlatformStand = false
            end
            if bv then bv:Destroy() bv = nil end
            if bg then bg:Destroy() bg = nil end
        end
    end
})

