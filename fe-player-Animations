local function applyAnimations(character)
	local humanoid = character:WaitForChild("Humanoid")
	local animator = humanoid:WaitForChild("Animator")
	local animate = character:WaitForChild("Animate")

	local pack = packs[a] or packs[2]

	for _, track in animator:GetPlayingAnimationTracks() do
		track:Stop(0)
	end

	animate.run.RunAnim.AnimationId = "rbxassetid://" .. pack.run
	animate.walk.WalkAnim.AnimationId = "rbxassetid://" .. pack.walk
	animate.jump.JumpAnim.AnimationId = "rbxassetid://" .. pack.jump
	animate.idle.Animation1.AnimationId = "rbxassetid://" .. pack.idle1
	animate.idle.Animation2.AnimationId = "rbxassetid://" .. pack.idle2
	animate.fall.FallAnim.AnimationId = "rbxassetid://" .. pack.fall
	animate.swim.Swim.AnimationId = "rbxassetid://" .. pack.swim
	animate.swimidle.SwimIdle.AnimationId = "rbxassetid://" .. pack.swimidle
	animate.climb.ClimbAnim.AnimationId = "rbxassetid://" .. pack.climb
end

if player.Character then
	applyAnimations(player.Character)
end

player.CharacterAdded:Connect(applyAnimations)
